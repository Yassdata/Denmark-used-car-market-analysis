// I count cars listed for sale at the snapshot date.
Active Listings = COALESCE(SUM(MarketSnapshot[active_inventory]), 0)

// I count distinct cars recorded as sold over the preceding 45 days.
Recorded Sales in 45 Days = COALESCE(SUM(MarketSnapshot[sold_last_45d]), 0)

Market Days Supply = DIVIDE(45 * [Active Listings], [Recorded Sales in 45 Days])

Snapshot Date = CALCULATE(MAX(MarketSnapshot[as_of_date]), REMOVEFILTERS(MarketSnapshot))

Sales Coverage Note = IF([Recorded Sales in 45 Days] = 0, "No recent sales")
