{
  "name": "DanishUsedCarDemand",
  "compatibilityLevel": 1601,
  "model": {
    "culture": "en-US",
    "sourceQueryCulture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "Vehicles",
        "columns": [
          {
            "name": "vehicleid",
            "dataType": "string",
            "sourceColumn": "vehicleid",
            "summarizeBy": "none"
          },
          {
            "name": "country",
            "dataType": "string",
            "sourceColumn": "country",
            "summarizeBy": "none"
          },
          {
            "name": "pricedate",
            "dataType": "dateTime",
            "sourceColumn": "pricedate",
            "summarizeBy": "none"
          },
          {
            "name": "datasnapshotdate",
            "dataType": "dateTime",
            "sourceColumn": "datasnapshotdate",
            "summarizeBy": "none"
          },
          {
            "name": "marketentrydate",
            "dataType": "dateTime",
            "sourceColumn": "marketentrydate",
            "summarizeBy": "none"
          },
          {
            "name": "marketexitdate",
            "dataType": "dateTime",
            "sourceColumn": "marketexitdate",
            "summarizeBy": "none"
          },
          {
            "name": "sold",
            "dataType": "int64",
            "sourceColumn": "sold",
            "summarizeBy": "none"
          },
          {
            "name": "daystosell",
            "dataType": "double",
            "sourceColumn": "daystosell",
            "summarizeBy": "none"
          },
          {
            "name": "makename",
            "dataType": "string",
            "sourceColumn": "makename",
            "summarizeBy": "none"
          },
          {
            "name": "modelname",
            "dataType": "string",
            "sourceColumn": "modelname",
            "summarizeBy": "none"
          },
          {
            "name": "fueltype",
            "dataType": "string",
            "sourceColumn": "fueltype",
            "summarizeBy": "none"
          },
          {
            "name": "transmissiontype",
            "dataType": "string",
            "sourceColumn": "transmissiontype",
            "summarizeBy": "none"
          },
          {
            "name": "odometerkm",
            "dataType": "double",
            "sourceColumn": "odometerkm",
            "summarizeBy": "none"
          },
          {
            "name": "eligible_90d",
            "dataType": "int64",
            "sourceColumn": "eligible_90d",
            "summarizeBy": "none"
          },
          {
            "name": "sold_within_90d",
            "dataType": "int64",
            "sourceColumn": "sold_within_90d",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Eligible Cars",
            "expression": "COALESCE(SUM(Vehicles[eligible_90d]), 0)",
            "formatString": "#,0"
          },
          {
            "name": "Sold Within 90 Days",
            "expression": "COALESCE(SUM(Vehicles[sold_within_90d]), 0)",
            "formatString": "#,0"
          },
          {
            "name": "Recorded 90-Day Sell-Through",
            "expression": "DIVIDE([Sold Within 90 Days], [Eligible Cars])",
            "formatString": "0.00%"
          },
          {
            "name": "Sample Size Note",
            "expression": "SWITCH(\n        TRUE(),\n        [Eligible Cars] = 0, \"No eligible cars\",\n        [Eligible Cars] < 30, \"Small sample\",\n        BLANK()\n    )"
          }
        ],
        "partitions": [
          {
            "name": "Vehicles",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Binary.FromText(\"\", BinaryEncoding.Base64), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"vehicleid\", type text}, {\"country\", type text}, {\"pricedate\", type date}, {\"datasnapshotdate\", type datetime}, {\"marketentrydate\", type date}, {\"marketexitdate\", type date}, {\"sold\", Int64.Type}, {\"daystosell\", type number}, {\"makename\", type text}, {\"modelname\", type text}, {\"fueltype\", type text}, {\"transmissiontype\", type text}, {\"odometerkm\", type number}, {\"eligible_90d\", Int64.Type}, {\"sold_within_90d\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      }
    ]
  }
}
