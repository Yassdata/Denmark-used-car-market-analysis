{
  "name": "DanishUsedCarDemand",
  "compatibilityLevel": 1601,
  "model": {
    "culture": "en-US",
    "sourceQueryCulture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "MarketSnapshot",
        "columns": [
          {
            "name": "as_of_date",
            "dataType": "dateTime",
            "sourceColumn": "as_of_date",
            "summarizeBy": "none"
          },
          {
            "name": "vehicleid",
            "dataType": "string",
            "sourceColumn": "vehicleid",
            "summarizeBy": "none"
          },
          {
            "name": "makename",
            "dataType": "string",
            "sourceColumn": "makename",
            "summarizeBy": "none"
          },
          {
            "name": "modelname",
            "dataType": "string",
            "sourceColumn": "modelname",
            "summarizeBy": "none"
          },
          {
            "name": "fueltype",
            "dataType": "string",
            "sourceColumn": "fueltype",
            "summarizeBy": "none"
          },
          {
            "name": "transmissiontype",
            "dataType": "string",
            "sourceColumn": "transmissiontype",
            "summarizeBy": "none"
          },
          {
            "name": "odometerkm",
            "dataType": "double",
            "sourceColumn": "odometerkm",
            "summarizeBy": "none"
          },
          {
            "name": "active_inventory",
            "dataType": "int64",
            "sourceColumn": "active_inventory",
            "summarizeBy": "none"
          },
          {
            "name": "sold_last_45d",
            "dataType": "int64",
            "sourceColumn": "sold_last_45d",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Active Listings",
            "expression": "COALESCE(SUM(MarketSnapshot[active_inventory]), 0)",
            "formatString": "#,0"
          },
          {
            "name": "Recorded Sales in 45 Days",
            "expression": "COALESCE(SUM(MarketSnapshot[sold_last_45d]), 0)",
            "formatString": "#,0"
          },
          {
            "name": "Market Days Supply",
            "expression": "DIVIDE(45 * [Active Listings], [Recorded Sales in 45 Days])",
            "formatString": "0.0"
          },
          {
            "name": "Snapshot Date",
            "expression": "CALCULATE(MAX(MarketSnapshot[as_of_date]), REMOVEFILTERS(MarketSnapshot))",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "Sales Coverage Note",
            "expression": "IF([Recorded Sales in 45 Days] = 0, \"No recent sales\")"
          }
        ],
        "partitions": [
          {
            "name": "MarketSnapshot",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Binary.FromText(\"\", BinaryEncoding.Base64), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"as_of_date\", type date}, {\"vehicleid\", type text}, {\"makename\", type text}, {\"modelname\", type text}, {\"fueltype\", type text}, {\"transmissiontype\", type text}, {\"odometerkm\", type number}, {\"active_inventory\", Int64.Type}, {\"sold_last_45d\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      }
    ]
  }
}
